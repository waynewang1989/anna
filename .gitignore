# ---- Python 虚拟环境 ----
# 不要提交: start.sh / start.bat 首次运行会自动创建并安装依赖
# (提交进来会带上本机绝对路径与上百 MB 二进制, 且换机器就失效)
.venv/
venv/
env/
ENV/

# ---- Python 缓存 / 构建产物 ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---- 测试 / 工具缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 运行时生成的本地产物 ----
# (自检截图写在 /tmp/rwtest/, 本来就在仓库外)
.requirements.stamp
*.log

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
